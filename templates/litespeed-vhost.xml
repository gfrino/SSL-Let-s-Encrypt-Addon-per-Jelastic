<?xml version="1.0" encoding="UTF-8"?>
<virtualHostConfig>
  <docRoot>/var/www/webroot/ROOT</docRoot>
  <enableGzip>1</enableGzip>
  
  <index>
    <useServer>0</useServer>
    <indexFiles>index.php, index.html</indexFiles>
    <autoIndex>0</autoIndex>
  </index>
  
  <htAccess>
    <allowOverride>31</allowOverride>
    <accessFileName>.htaccess</accessFileName>
  </htAccess>
  
  <security>
    <accessControl>
      <allow>*</allow>
    </accessControl>
  </security>
  
  <vhssl>
    <keyFile>/etc/letsencrypt/live/{DOMAIN}/privkey.pem</keyFile>
    <certFile>/etc/letsencrypt/live/{DOMAIN}/fullchain.pem</certFile>
    <certChain>1</certChain>
    <sslProtocol>24</sslProtocol>
  </vhssl>
  
  <contextList>
  </contextList>
  
  <rewrite>
    <enable>1</enable>
    <logLevel>0</logLevel>
  </rewrite>
</virtualHostConfig>
